RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here
NEXT_PUBLIC_CLARITY_ID=your_microsoft_clarity_id_here
# Canonical production domain — used for canonical URLs, JSON-LD @id values,
# sitemap.xml, robots.txt, and Open Graph URLs. Falls back to
# https://projoywebsolutions.com if unset, but should be set explicitly on
# every environment (including preview deployments) once the custom domain
# is live, so schema/canonicals never point at a *.vercel.app URL.
NEXT_PUBLIC_SITE_URL=https://projoywebsolutions.com